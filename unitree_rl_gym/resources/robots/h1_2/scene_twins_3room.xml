<mujoco model="h1_2 scene">
  <compiler meshdir="meshes" texturedir="meshes" angle="radian"/>
  <statistic center="1.0 0.7 1.0" extent="0.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="-20"/>
    <map shadowclip="40" znear="0.01" zfar="200"/>
    <quality shadowsize="0"/>
  </visual>



  <asset>
    <!-- регистрируем модель робота -->
    <model name="h1_2" file="h1_2_12dof.xml"/>
     <model name="table" file="table.xml"/>
     <model name="table_with_box" file="table_with_box.xml"/>

    <!-- небо + материал пола -->
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- стол: текстуры/материалы/меши -->
    <texture type="2d" name="table" file="table.png"/>
    <material name="table"      specular="0.3" shininess="0.5" rgba="0.62 0.62 0.6 1" texture="table"/>
    <material name="table_legs" specular="0.3" shininess="0.5" rgba="1 1 1 1"          texture="table"/>
    <mesh name="table"       file="table.obj"        scale="1 1 1"/>
    <mesh name="table_legs"  file="table_legs.obj"   scale="1 1 1"/>
    <mesh name="table_collision_001" file="table_collision_001.obj" scale="1 1 1"/>
    <mesh name="table_collision_002" file="table_collision_002.obj" scale="1 1 1"/>
    <mesh name="table_collision_003" file="table_collision_003.obj" scale="1 1 1"/>
    <mesh name="table_collision_004" file="table_collision_004.obj" scale="1 1 1"/>
    <mesh name="table_collision_005" file="table_collision_005.obj" scale="1 1 1"/>
    <mesh name="table_collision_006" file="table_collision_006.obj" scale="1 1 1"/>
    <mesh name="table_collision_007" file="table_collision_007.obj" scale="1 1 1"/>
  </asset>

  <worldbody>
    <!-- освещение и пол -->
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- два робота -->
    <frame name="r1_root" pos="-2 0 0">
      <attach model="h1_2" prefix="r1_"/>
    </frame>
    <frame name="r2_root" pos="2 0 0" euler="0 0 3.14">
      <attach model="h1_2" prefix="r2_"/>
    </frame>

     <frame name="r3_root" pos="0 2 0" euler="0 0 -1.57">
      <attach model="h1_2" prefix="r3_"/>
    </frame>

     

 <!-- Любое число столов: одна строка frame+attach на стол -->
    <frame name="table_1_root" pos="-1.4 0 0.0" euler="0 0 -1.57">
      <attach model="table_with_box" prefix="table1_"/>
    </frame>

    <frame name="table_2_root" pos="1.4 0 0.0" euler="0 0 1.57">
      <attach model="table_with_box" prefix="table2_"/>
    </frame>
     <frame name="table_3_root" pos="0 1.4 0.0" euler="0 0 3.14">
      <attach model="table" prefix="table3_"/>
    </frame>

   

    
  </worldbody>
</mujoco>
