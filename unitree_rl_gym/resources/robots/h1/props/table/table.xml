<?xml version="1.0" encoding="utf-8"?>
<mujoco model="table">
  <compiler angle="radian" meshdir="assets" texturedir="assets" autolimits="true"/>
  <asset>
    <texture type="2d" name="table" file="table.png"/>
    <material name="table" specular="0.3" shininess="0.5" rgba="0.62 0.62 0.6 1" texture="table"/>
    <material name="table_legs" specular="0.3" shininess="0.5" rgba="1 1 1 1" texture="table"/>
    <mesh file="table.obj"/>
    <mesh file="table_legs.obj"/>
    <mesh file="table_collision_001.obj"/>
    <mesh file="table_collision_002.obj"/>
    <mesh file="table_collision_003.obj"/>
    <mesh file="table_collision_004.obj"/>
    <mesh file="table_collision_005.obj"/>
    <mesh file="table_collision_006.obj"/>
    <mesh file="table_collision_007.obj"/>
  </asset>

  <!-- ИМЕНА КЛАССОВ ДОЛЖНЫ БЫТЬ УНИКАЛЬНЫМИ ВО ВСЁМ МОДЕЛЕ -->
  <default>
    <default class="prop_table">          <!-- было: table -->
      <default class="prop_visual">       <!-- было: visual -->
        <geom type="mesh" contype="0" conaffinity="0" group="2" euler="1.5708 0 0"/>
      </default>
      <default class="prop_collision">    <!-- было: collision -->
        <geom type="mesh" group="3" euler="1.5708 0 0"/>
      </default>
    </default>
  </default>

  <worldbody>
    <!-- childclass и class тоже обновили -->
    <body name="table" childclass="prop_table" pos="0.65 0.0 1.15">
      <geom name="mesh"       mesh="table"       class="prop_visual"   material="table"/>
      <geom name="mesh_legs"  mesh="table_legs"  class="prop_visual"   material="table_legs"/>
      <geom name="collider_001" mesh="table_collision_001" class="prop_collision"/>
      <geom name="collider_002" mesh="table_collision_002" class="prop_collision"/>
      <geom name="collider_003" mesh="table_collision_003" class="prop_collision"/>
      <geom name="collider_004" mesh="table_collision_004" class="prop_collision"/>
      <geom name="collider_005" mesh="table_collision_005" class="prop_collision"/>
      <geom name="collider_006" mesh="table_collision_006" class="prop_collision"/>
      <geom name="collider_007" mesh="table_collision_007" class="prop_collision"/>
    </body>
  </worldbody>
</mujoco>
